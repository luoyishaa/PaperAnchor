# Copy to .env in the project root. Fill the key for the selected provider.
# Environment variables override .env. Keep real keys out of version control.
PAPERANCHOR_PROVIDER=glm
PAPERANCHOR_MODEL_TIER=fast
ZHIPU_API_KEY=

# Other providers: deepseek, qwen, kimi, openai, gemini, anthropic, ollama.
# Hosted model presets and endpoints: src/paperanchor/model_config.py.
# Use a China (Beijing) region key for the Qwen preset.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Override a model preset or select an image-capable model from the same provider.
# PAPERANCHOR_MODEL_ID=
# PAPERANCHOR_VISION_MODEL_ID=

# Local Ollama: pull the models and start Ollama before using these settings.
# PAPERANCHOR_PROVIDER=ollama
# PAPERANCHOR_MODEL_ID=qwen3:8b
# PAPERANCHOR_VISION_MODEL_ID=qwen3-vl:4b-thinking
# PAPERANCHOR_OLLAMA_BASE_URL=http://127.0.0.1:11434
# PAPERANCHOR_OLLAMA_THINKING=auto

# Optional discovery key and reranker for Standard search / CLI ask.
SEMANTIC_SCHOLAR_API_KEY=
# PAPERANCHOR_RERANK_MODEL=BAAI/bge-reranker-base

# Answer workflow: direct (default), or agent for bounded evidence-check retries.
# PAPERANCHOR_ANSWER_MODE=agent
# Index representation: units (default), or blocks for source-block retrieval.
# PAPERANCHOR_REPRESENTATION=blocks

# Provider-specific reasoning settings. Leave unset for other providers.
# PAPERANCHOR_THINKING=disabled
# PAPERANCHOR_REASONING_EFFORT=low

# Optional output and request limits.
# PAPERANCHOR_TEXT_MAX_TOKENS=2048
# PAPERANCHOR_VISION_MAX_TOKENS=2048
# PAPERANCHOR_REQUEST_TIMEOUT=120
# PAPERANCHOR_MAX_RETRIES=2
