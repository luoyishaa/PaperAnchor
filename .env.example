# Copy this file to .env in the project root. Only .env is read at runtime.
# For the default setup, fill DEEPSEEK_API_KEY and leave everything else as-is.
# To switch providers, change PAPERANCHOR_PROVIDER and fill that provider's key.
# Model IDs and direct official endpoints are defined in src/paperanchor/model_config.py.

PAPERANCHOR_PROVIDER=deepseek
PAPERANCHOR_MODEL_TIER=fast
# Optional: override the selected preset with an exact provider model ID.
# PAPERANCHOR_MODEL_ID=

# Official provider keys. Leave unused providers blank. Never commit real keys.
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Presets (fast / pro), verified against official provider docs in Sep 2026:
# deepseek  https://api.deepseek.com                         deepseek-flash / deepseek-v4-pro
# glm       https://open.bigmodel.cn/api/paas/v4            glm-5.3-flash / glm-5.3
# qwen      https://dashscope.aliyuncs.com/compatible-mode/v1  qwen3.8-flash / qwen3.8-max
# kimi      https://api.moonshot.cn/v1                      kimi-k2.6 / kimi-k3
# openai    https://api.openai.com/v1                       gpt-6-luna / gpt-6-sol
# gemini    https://generativelanguage.googleapis.com/v1beta/openai/  gemini-3.8-flash / gemini-3.1-pro-preview
# anthropic Native Claude Messages API                       claude-haiku-4-5 / claude-opus-5-5
# DeepSeek currently routes deepseek-v4-pro requests to Flash pending its next Pro release.
# Qwen's preset endpoint uses the China (Beijing) region; use a key from that region.
